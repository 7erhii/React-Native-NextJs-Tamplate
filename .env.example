# =============================================================================
# App environment — TEMPLATE
#
# Copy once at the repo root:   cp .env.example .env
#
# Expo (apps/mobile) and Next (apps/web) both load this file. You do not copy
# it into the app folders. Case A (local + device) does not need a .env at all.
#
# ⚠️  EXPO_PUBLIC_* and NEXT_PUBLIC_* are inlined into client bundles.
#     Only the *anon* key may appear here. The service-role key belongs
#     exclusively to infra/supabase/.env.
# =============================================================================

# Value of KONG_HTTP_PORT from infra/supabase/.env — 54321 by default.
# On a physical device use your LAN IP instead of localhost, e.g.
#   http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321

# The ANON_KEY from infra/supabase/.env. Must carry the "anon" role; the app
# refuses to start if it carries anything more privileged.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_JWT

# Optional. If omitted, the load-root-env script aliases the EXPO_PUBLIC_ pair
# to NEXT_PUBLIC_ so the website talks to the same project.
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_JWT
