# =============================================================================
# Supabase stack configuration — TEMPLATE
#
# Copy to `.env` in this directory and fill in real values. `.env` is gitignored
# and must stay that way.
#
#   cp infra/supabase/.env.example infra/supabase/.env
#
# Generate every secret locally. Never reuse a value from a tutorial, a blog
# post, or another project:
#
#   openssl rand -hex 32
#
# ⚠️  SERVICE_ROLE_KEY bypasses row-level security entirely. It belongs only in
#     this file. It must never appear in the project-root `.env`, in `app.json`,
#     or behind any `EXPO_PUBLIC_` variable — anything prefixed EXPO_PUBLIC_ is
#     compiled into the shipped app bundle and readable by anyone who downloads
#     it.
# =============================================================================

# ---- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---- JWT --------------------------------------------------------------------
# Must be at least 32 characters or the auth container will refuse to start.
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# Both are JWTs signed with JWT_SECRET above, carrying role "anon" and
# "service_role" respectively. Derive them with the Supabase self-hosting key
# generator, or any JWT tool, using payloads:
#   {"role":"anon","iss":"supabase","iat":<now>,"exp":<now + 10 years>}
#   {"role":"service_role","iss":"supabase","iat":<now>,"exp":<now + 10 years>}
ANON_KEY=YOUR_ANON_KEY_JWT
SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_JWT

# ---- URLs -------------------------------------------------------------------
# On a physical device, `localhost` is the phone, not your machine. Use your LAN
# IP (e.g. http://192.168.1.20:54321) and add it to ADDITIONAL_REDIRECT_URLS.
API_EXTERNAL_URL=http://localhost:54321
SUPABASE_PUBLIC_URL=http://localhost:54321
SITE_URL=mobileworld://

# Comma-separated OAuth redirect allow-list. The app scheme entry is required for
# native sign-in to complete.
ADDITIONAL_REDIRECT_URLS=mobileworld://auth-callback,mobileworld://,http://localhost:8081,http://localhost:3000

# ---- Google OAuth -----------------------------------------------------------
# Create an OAuth 2.0 **Web application** client in Google Cloud Console. The web
# type is correct even for a mobile app here, because the token exchange happens
# in this container and not on the device.
#
# Authorized redirect URI:
#   http://localhost:54321/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ---- Studio -----------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=Mobile World
STUDIO_DEFAULT_PROJECT=mobile-world
STUDIO_PORT=54323
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=54443

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=YOUR_DASHBOARD_PASSWORD

# ---- Mail (local development only) -----------------------------------------
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Mobile World
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
DISABLE_SIGNUP=false
JWT_EXPIRY=3600

# ---- Misc service defaults --------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public
FUNCTIONS_VERIFY_JWT=true
IMGPROXY_ENABLE_WEBP_DETECTION=true
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
POOLER_TENANT_ID=mobile-world
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DB_POOL_SIZE=5
SECRET_KEY_BASE=YOUR_SECRET_KEY_BASE_64_CHARS
VAULT_ENC_KEY=YOUR_VAULT_ENC_KEY_32_CHARS
LOGFLARE_PUBLIC_ACCESS_TOKEN=YOUR_LOGFLARE_PUBLIC_TOKEN
LOGFLARE_PRIVATE_ACCESS_TOKEN=YOUR_LOGFLARE_PRIVATE_TOKEN
# v1.24.x compose still interpolates these names — stack-up copies the public token into both.
LOGFLARE_API_KEY=YOUR_LOGFLARE_PUBLIC_TOKEN
LOGFLARE_LOGGER_BACKEND_API_KEY=YOUR_LOGFLARE_PUBLIC_TOKEN
